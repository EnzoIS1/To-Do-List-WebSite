# Copie ce fichier en .env.local et renseigne tes valeurs.
# .env.local ne doit JAMAIS être commité : il est déjà dans .gitignore.
#
# Les deux valeurs sont dans Supabase : Project Settings → API
#
# La clé anon est PUBLIQUE par conception : elle part dans le fichier
# JavaScript compilé et n'importe qui peut la lire. Ce sont les policies
# RLS (migration 0002) qui protègent les données, pas le secret de la clé.
#
# Ne mets JAMAIS la clé service_role ici : elle contourne toutes les policies.

VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Clé publique des notifications (VAPID). Publique par conception, comme la
# clé anon : elle part dans le JavaScript compilé. La clé PRIVÉE, elle, ne
# vit que dans les secrets de la fonction Supabase — jamais ici, jamais sur
# GitHub. Les deux se génèrent ensemble, voir le README.
VITE_VAPID_PUBLIQUE=
